#!/usr/bin/make -f
SHELL := /bin/bash

.PHONY: build clean binary-indep binary-arch binary

build:
	cd projectlibre_contrib && ant -Dshrink=false dist
	cd projectlibre_build && ant -Dbuild.compiler.warnings=false -Dbuild_contrib=false

clean:
	cd projectlibre_contrib && ant clean
	cd projectlibre_build && ant clean
	rm -rf debian/tmp

binary-indep: build
	rm -rf debian/tmp
	cd projectlibre_build && ant -Dbuild.compiler.warnings=false -Dbuild_contrib=false -Ddeb=../debian/tmp deb-binary
	dpkg-deb --root-owner-group --build debian/tmp ..

binary-arch: build

binary: binary-indep binary-arch
